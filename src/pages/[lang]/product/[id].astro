---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Navbar from '../../../components/Navbar.astro';
import Footer from '../../../components/Footer.astro';
import ProductGallery from '../../../components/ProductGallery.astro';
import products from '../../../data/products.json';
import categories from '../../../data/categories.json';
import { useTranslations, localizePath, pick, languages, type Lang } from '../../../i18n/ui';

export function getStaticPaths() {
  const langs = Object.keys(languages) as Lang[];
  const paths: any[] = [];
  for (const lang of langs) {
    for (const product of products) {
      paths.push({ params: { lang, id: product.id }, props: { product } });
    }
  }
  return paths;
}

const lang = Astro.params.lang as Lang;
const { product } = Astro.props;
const t = useTranslations(lang);

const name = pick(product.name, lang) as string;
const tag = pick(product.tag, lang) as string;
const description = pick(product.description, lang) as string;
const badges = (pick(product.badges, lang) as { text: string; primary: boolean }[]) ?? [];
const stats = (pick(product.stats, lang) as { value: string; unit: string; label: string }[]) ?? [];
const specGroups = (pick(product.specGroups, lang) as { title: string; rows: { k: string; v: string }[] }[]) ?? [];
const included = (pick(product.included, lang) as string[]) ?? [];
const category = categories.find((c) => c.id === product.category);
const categoryName = (pick(category?.name, lang) as string) ?? product.category;

const quoteSubject = encodeURIComponent(`Quote request: ${name}`);
const mailtoUrl = `mailto:sales@globalrobotex.com?subject=${quoteSubject}`;
---

<BaseLayout lang={lang} title={`${name} | GlobalRobotex`} description={description} image={product.image}>
  <Navbar lang={lang} />
  <main class="product-page">
    <div class="container-wide">

      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href={localizePath('/', lang)}>{t('product.home')}</a>
        <span>/</span>
        <a href={localizePath('/catalog', lang)}>{t('nav.catalog')}</a>
        <span>/</span>
        <span class="bc-current">{name}</span>
      </nav>

      <div class="product-layout">
        <div>
          <ProductGallery name={name} image={product.image} images={product.images} model3d={product.model3d} lang={lang} />
        </div>

        <div class="product-details">
          <span class="prod-cat">{categoryName}</span>
          <h1 class="prod-name">{name}</h1>
          {tag && <div class="prod-tag">{tag}</div>}

          {badges.length > 0 && (
            <div class="badges">
              {badges.map((b) => (
                <span class={`badge ${b.primary ? 'badge-blue' : 'badge-gray'}`}>{b.text}</span>
              ))}
            </div>
          )}

          <p class="prod-desc">{description}</p>

          {stats.length > 0 && (
            <div class="stats-strip">
              {stats.map((s) => (
                <div class="stat-cell">
                  <div class="stat-num">{s.value}<span class="stat-unit">{s.unit}</span></div>
                  <div class="stat-lbl">{s.label}</div>
                </div>
              ))}
            </div>
          )}

          <a href={mailtoUrl} class="btn btn-primary cta-btn">
            {t('common.requestQuote')}
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M2 4l6 4 6-4M2 4h12v9H2z" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Full specifications -->
      {specGroups.length > 0 && (
        <section class="spec-section">
          <h2 class="block-title">{t('product.fullSpecs')}</h2>
          <div class="spec-groups">
            {specGroups.map((g) => (
              <div class="spec-group">
                <div class="spec-group-title">{g.title}</div>
                <dl class="spec-table">
                  {g.rows.map((r) => (
                    <div class="spec-row">
                      <dt class="spec-key">{r.k}</dt>
                      <dd class="spec-val">{r.v}</dd>
                    </div>
                  ))}
                </dl>
              </div>
            ))}
          </div>
        </section>
      )}

      <!-- Package contents -->
      {included.length > 0 && (
        <section class="incl-section">
          <h2 class="block-title">{t('product.included')}</h2>
          <ul class="incl-list">
            {included.map((item) => (
              <li>
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                  <circle cx="8" cy="8" r="7" stroke="currentColor" stroke-width="1.3"/>
                  <path d="M5 8l2 2 4-4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </section>
      )}

    </div>
  </main>
  <Footer lang={lang} />
</BaseLayout>

<style>
  .product-page { padding: 16px 0 80px; }

  .breadcrumb {
    display: flex; align-items: center; gap: 8px;
    font-size: 13px; color: var(--t3); margin-bottom: 24px;
  }
  .breadcrumb a { color: var(--t3); text-decoration: none; transition: color 0.15s; }
  .breadcrumb a:hover { color: var(--accent); }
  .bc-current { color: var(--t1); font-weight: 500; }

  .product-layout {
    display: grid; grid-template-columns: 1fr 1fr;
    gap: 48px; align-items: start; margin-bottom: 56px;
  }

  .prod-cat {
    display: block; font-size: 11px; font-weight: 600;
    letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--accent); margin-bottom: 8px;
  }
  .prod-name {
    font-size: clamp(24px, 3vw, 34px);
    font-weight: 800; letter-spacing: -0.02em; line-height: 1.15;
    margin-bottom: 6px; color: var(--t1);
  }
  .prod-tag {
    font-family: var(--mono); font-size: 13px;
    color: var(--t3); margin-bottom: 16px;
  }
  .badges { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 20px; }
  .prod-desc { font-size: 15px; color: var(--t2); line-height: 1.75; margin-bottom: 28px; }

  .stats-strip {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(90px, 1fr));
    gap: 1px; background: var(--border);
    border: 1px solid var(--border); border-radius: var(--r-lg);
    overflow: hidden; margin-bottom: 28px;
  }
  .stat-cell { background: var(--bg-card); padding: 16px 14px; text-align: center; }
  .stat-num { font-size: 24px; font-weight: 800; color: var(--t1); letter-spacing: -0.02em; }
  .stat-unit { font-size: 13px; font-weight: 600; color: var(--accent); margin-left: 3px; }
  .stat-lbl {
    font-size: 10px; color: var(--t3); text-transform: uppercase;
    letter-spacing: 0.08em; margin-top: 4px;
  }

  .cta-btn { padding: 13px 28px; font-size: 15px; }

  .block-title {
    font-size: 13px; font-weight: 600;
    letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--t3); margin-bottom: 16px;
  }

  .spec-section { margin-bottom: 56px; }
  .spec-groups {
    display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px;
  }
  .spec-group-title {
    font-size: 13px; font-weight: 700; color: var(--accent-h);
    margin-bottom: 10px;
  }
  .spec-table { border: 1px solid var(--border); border-radius: var(--r-lg); overflow: hidden; }
  .spec-row {
    display: grid; grid-template-columns: 1fr 1fr;
    border-bottom: 1px solid var(--border);
    font-size: 13px;
  }
  .spec-row:last-child { border-bottom: none; }
  .spec-key {
    padding: 9px 14px; color: var(--t3);
    background: var(--bg-2); border-right: 1px solid var(--border);
  }
  .spec-val { padding: 9px 14px; color: var(--t1); font-weight: 500; font-family: var(--mono); }

  .incl-section { margin-bottom: 24px; }
  .incl-list { list-style: none; display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; }
  .incl-list li {
    display: flex; align-items: flex-start; gap: 10px;
    font-size: 14px; color: var(--t2); line-height: 1.5;
  }
  .incl-list svg { color: var(--accent); flex-shrink: 0; margin-top: 2px; }

  @media (max-width: 900px) {
    .product-layout { grid-template-columns: 1fr; gap: 32px; }
    .spec-groups { grid-template-columns: 1fr; }
    .incl-list { grid-template-columns: 1fr; }
  }
</style>
