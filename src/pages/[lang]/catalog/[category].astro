---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Navbar from '../../../components/Navbar.astro';
import Footer from '../../../components/Footer.astro';
import HeroSection from '../../../components/HeroSection.astro';
import CatalogClient from '../../../components/CatalogClient.astro';
import products from '../../../data/products.json';
import categories from '../../../data/categories.json';
import { useTranslations, pick, languages, type Lang } from '../../../i18n/ui';

export function getStaticPaths() {
  const langs = Object.keys(languages) as Lang[];
  const paths: any[] = [];
  for (const lang of langs) {
    for (const cat of categories) {
      if (cat.id === 'all') continue;
      paths.push({ params: { lang, category: cat.slug }, props: { categoryId: cat.id } });
    }
  }
  return paths;
}

const lang = Astro.params.lang as Lang;
const { categoryId } = Astro.props;
const t = useTranslations(lang);
const category = categories.find((c) => c.id === categoryId);
const categoryName = (pick(category?.name, lang) as string) ?? categoryId;
const subtitle = `${t('catalog.browseRange')} ${categoryName.toLowerCase()}.`;
---

<BaseLayout lang={lang} title={`${categoryName} | GlobalRobotex`} description={subtitle}>
  <Navbar lang={lang} />
  <main>
    <HeroSection lang={lang} title={categoryName} subtitle={subtitle} />
    <section class="py-12">
      <div class="container-wide">
        <CatalogClient products={products} categories={categories} initialCategory={categoryId} perPage={12} lang={lang} />
      </div>
    </section>
  </main>
  <Footer lang={lang} />
</BaseLayout>

<style>
  .py-12 { padding: 48px 0; }
</style>
