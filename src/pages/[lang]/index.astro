---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import ProductCard from '../../components/ProductCard.astro';
import products from '../../data/products.json';
import categories from '../../data/categories.json';
import { useTranslations, localizePath, pick, languages, type Lang } from '../../i18n/ui';

export function getStaticPaths() {
  return (Object.keys(languages) as Lang[]).map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const featured = products.slice(0, 8);
const catName = (slug: string) =>
  (pick(categories.find((c) => c.id === slug)?.name, lang) as string) ?? slug;
---

<BaseLayout lang={lang} title="GlobalRobotex — Unmanned Robotic Systems" description={t('home.sub')}>
  <Navbar lang={lang} />
  <main>

    <!-- HERO -->
    <section class="hero">
      <div class="container hero-layout">
        <div class="hero-text">
          <div class="section-label">{t('home.label')}</div>
          <h1 set:html={t('home.title')} />
          <p class="hero-sub">{t('home.sub')}</p>
          <div class="hero-actions">
            <a href={localizePath('/catalog', lang)} class="btn btn-primary">{t('common.viewCatalog')}</a>
            <a href={`/catalog.${lang}.pdf`} target="_blank" rel="noopener" class="btn btn-outline">{t('common.downloadCatalog')}</a>
          </div>
          <div class="hero-stats">
            <div class="stat"><span class="sv">{t('home.stat1.v')}</span><span class="sl">{t('home.stat1.l')}</span></div>
            <div class="sdiv"></div>
            <div class="stat"><span class="sv">{t('home.stat2.v')}</span><span class="sl">{t('home.stat2.l')}</span></div>
            <div class="sdiv"></div>
            <div class="stat"><span class="sv">{t('home.stat3.v')}</span><span class="sl">{t('home.stat3.l')}</span></div>
          </div>
        </div>

        <div class="hero-visual" aria-hidden="true">
          <img src="/images/logo.png" alt="GlobalRobotex" class="hero-logo" />
        </div>
      </div>
      <div class="glow" aria-hidden="true"></div>
    </section>

    <!-- FEATURED PRODUCTS -->
    <section class="catalog-section">
      <div class="container-wide">
        <div class="section-label">{t('home.products.label')}</div>
        <h2>{t('home.products.title')}</h2>

        <div class="product-grid">
          {featured.map((p) => (
            <ProductCard product={p} lang={lang} categoryName={catName(p.category)} />
          ))}
        </div>

        <div class="catalog-cta">
          <a href={localizePath('/catalog', lang)} class="btn btn-outline">
            {t('home.viewFullCatalog')}
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        </div>
      </div>
    </section>

    <!-- VALUES -->
    <section class="values-section">
      <div class="container">
        <div class="values-grid">
          <div class="value-card">
            <div class="vc-icon">
              <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                <path d="M10 2L12.5 7.5H18L13.5 11L15.5 17L10 13.5L4.5 17L6.5 11L2 7.5H7.5L10 2Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
              </svg>
            </div>
            <div class="vc-title">{t('home.val1.t')}</div>
            <div class="vc-desc">{t('home.val1.d')}</div>
          </div>
          <div class="value-card">
            <div class="vc-icon">
              <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                <circle cx="10" cy="10" r="8" stroke="currentColor" stroke-width="1.4"/>
                <path d="M6.5 10l2.5 2.5 4.5-4.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
            <div class="vc-title">{t('home.val2.t')}</div>
            <div class="vc-desc">{t('home.val2.d')}</div>
          </div>
          <div class="value-card">
            <div class="vc-icon">
              <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                <rect x="3" y="4" width="14" height="12" rx="1.5" stroke="currentColor" stroke-width="1.4"/>
                <line x1="6" y1="8" x2="14" y2="8" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
                <line x1="6" y1="11" x2="14" y2="11" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
                <line x1="6" y1="14" x2="10" y2="14" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
              </svg>
            </div>
            <div class="vc-title">{t('home.val3.t')}</div>
            <div class="vc-desc">{t('home.val3.d')}</div>
          </div>
        </div>
      </div>
    </section>

  </main>
  <Footer lang={lang} />
</BaseLayout>

<style>
  .hero {
    position: relative; overflow: hidden;
    padding: 88px 0 72px;
    border-bottom: 1px solid var(--border);
  }
  .hero-layout {
    display: grid;
    grid-template-columns: 1fr 420px;
    gap: 48px;
    align-items: center;
  }
  .hero h1 { margin: 8px 0 20px; }
  .hero h1 :global(.accent) { color: var(--accent); }
  .hero-sub {
    font-size: 16px; color: var(--t2);
    max-width: 520px; line-height: 1.7; margin-bottom: 32px;
  }
  .hero-actions { display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 48px; }
  .hero-stats { display: flex; align-items: center; gap: 24px; flex-wrap: wrap; }
  .stat { display: flex; flex-direction: column; gap: 2px; }
  .sv { font-size: 22px; font-weight: 700; color: var(--t1); letter-spacing: -0.01em; }
  .sl { font-size: 11px; color: var(--t3); text-transform: uppercase; letter-spacing: 0.1em; }
  .sdiv { width: 1px; height: 36px; background: var(--border); }

  .hero-visual { display: flex; align-items: center; justify-content: center; }
  .hero-logo {
    width: 100%; max-width: 360px; height: auto;
    filter: drop-shadow(0 0 40px rgba(58,143,232,0.18));
  }

  .glow {
    position: absolute; top: -100px; right: -100px;
    width: 700px; height: 700px; pointer-events: none;
    background: radial-gradient(circle, rgba(58,143,232,0.07) 0%, transparent 65%);
  }

  .catalog-section { padding: 72px 0; }
  .catalog-section h2 { margin-bottom: 36px; }
  .product-grid {
    display: grid; grid-template-columns: repeat(4, 1fr);
    gap: 16px; margin-bottom: 40px;
  }
  .catalog-cta { text-align: center; }

  .values-section {
    padding: 64px 0;
    background: var(--bg-2);
    border-top: 1px solid var(--border);
  }
  .values-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .value-card {
    padding: 24px;
    background: var(--bg-card); border: 1px solid var(--border);
    border-radius: var(--r-lg);
  }
  .vc-icon {
    width: 40px; height: 40px; border-radius: var(--r);
    background: var(--accent-t); border: 1px solid rgba(58,143,232,0.2);
    display: flex; align-items: center; justify-content: center;
    color: var(--accent); margin-bottom: 16px;
  }
  .vc-title { font-size: 14px; font-weight: 700; color: var(--t1); margin-bottom: 6px; }
  .vc-desc { font-size: 13px; color: var(--t3); line-height: 1.6; }

  @media (max-width: 1100px) { .hero-layout { grid-template-columns: 1fr 320px; gap: 32px; } }
  @media (max-width: 860px) {
    .hero-layout { grid-template-columns: 1fr; }
    .hero-visual { display: none; }
  }
  @media (max-width: 1200px) { .product-grid { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 860px)  { .product-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 540px) {
    .product-grid { grid-template-columns: 1fr; }
    .values-grid  { grid-template-columns: 1fr; }
    .hero { padding: 60px 0 48px; }
  }
</style>
