---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import HeroSection from '../../components/HeroSection.astro';
import { useTranslations, languages, type Lang } from '../../i18n/ui';

export function getStaticPaths() {
  return (Object.keys(languages) as Lang[]).map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const mailto = 'mailto:sales@globalrobotex.com?subject=Quote%20Request';
---

<BaseLayout lang={lang} title={`${t('contact.title')} | GlobalRobotex`} description={t('contact.sub')}>
  <Navbar lang={lang} />
  <main>
    <HeroSection lang={lang} title={t('contact.title')} subtitle={t('contact.sub')} />
    <section class="contact-body">
      <div class="container narrow">
        <div class="contact-card">
          <h2 class="contact-title">{t('contact.getInTouch')}</h2>

          <div class="contact-block">
            <h3>{t('contact.email')}</h3>
            <a href="mailto:sales@globalrobotex.com" class="contact-email">sales@globalrobotex.com</a>
            <p class="muted">{t('contact.emailNote')}</p>
          </div>

          <div class="contact-block">
            <h3>{t('contact.hours')}</h3>
            <p>{t('contact.hoursValue')}</p>
          </div>

          <div class="contact-block">
            <h3>{t('contact.quote')}</h3>
            <p class="muted">{t('contact.quoteNote')}</p>
            <a href={mailto} class="btn btn-primary">
              {t('contact.sendEmail')}
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M2 4l6 4 6-4M2 4h12v9H2z" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
          </div>

          <div class="contact-block">
            <a href={`/catalog.${lang}.pdf`} target="_blank" rel="noopener" class="btn btn-outline">{t('common.downloadCatalog')}</a>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer lang={lang} />
</BaseLayout>

<style>
  .contact-body { padding: 64px 0; }
  .narrow { max-width: 680px; }
  .contact-card {
    background: var(--bg-card); border: 1px solid var(--border);
    border-radius: var(--r-lg); padding: 32px;
  }
  .contact-title { font-size: 20px; margin-bottom: 24px; }
  .contact-block { margin-bottom: 24px; }
  .contact-block:last-child { margin-bottom: 0; }
  .contact-block h3 {
    font-size: 11px; font-weight: 600; letter-spacing: 0.1em;
    text-transform: uppercase; color: var(--t3); margin-bottom: 8px;
  }
  .contact-block p { color: var(--t2); }
  .contact-block .muted { color: var(--t3); font-size: 14px; margin-bottom: 14px; }
  .contact-email { color: var(--accent); font-weight: 600; text-decoration: none; }
  .contact-email:hover { text-decoration: underline; }
</style>
