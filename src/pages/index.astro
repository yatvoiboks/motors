---
// Корень перенаправляет на язык по умолчанию (EN) — статический meta-refresh.
const target = '/en/';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={target} />
    <title>GlobalRobotex</title>
    <script is:inline define:vars={{ target }}>window.location.replace(target);</script>
  </head>
  <body>
    <a href={target}>GlobalRobotex →</a>
  </body>
</html>
