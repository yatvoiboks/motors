---
import SearchBar from './SearchBar.astro';
import CategoryFilter from './CategoryFilter.astro';
import { useTranslations, pick, type Lang } from '../i18n/ui';

interface Props {
  products: any[];
  categories: any[];
  initialCategory?: string;
  perPage?: number;
  lang: Lang;
}

const { products, categories, initialCategory = 'all', perPage = 12, lang } = Astro.props;
const t = useTranslations(lang);

const catName = (slug: string) =>
  (pick(categories.find((c) => c.id === slug)?.name, lang) as string) ?? slug;

// Заранее разворачиваем в нужный язык — клиентский JS работает с готовыми строками.
const resolved = products.map((p) => ({
  id: p.id,
  name: pick(p.name, lang),
  description: pick(p.description, lang),
  tag: pick(p.tag, lang),
  category: p.category,
  categoryName: catName(p.category),
  image: p.images?.length ? p.images[0] : p.image,
  specs: pick(p.specs, lang) ?? {},
  has3d: Boolean(p.model3d),
}));

const strings = {
  empty: t('catalog.empty'),
  showing: t('catalog.showing'),
  of: t('catalog.of'),
  products: t('catalog.products'),
  prev: t('catalog.prev'),
  next: t('catalog.next'),
  page: t('catalog.page'),
  pageOf: t('catalog.pageOf'),
  details: t('common.details'),
  requestQuote: t('common.requestQuote'),
};

const serialized = JSON.stringify({ products: resolved, initialCategory, perPage, lang, strings });
---

<div id="catalog-client" class="catalog-client" data-config={serialized}>
  <div class="cat-controls">
    <SearchBar placeholder={t('catalog.search')} />
    <CategoryFilter categories={categories} activeCategory={initialCategory} lang={lang} clientFilter />
  </div>
  <div id="catalog-results" class="cat-grid"></div>
  <div id="catalog-empty" class="cat-empty" hidden>
    <p>{t('catalog.empty')}</p>
  </div>
  <div id="catalog-pagination" class="cat-pagination"></div>
</div>

<script>
  (function () {
    const container = document.getElementById('catalog-client');
    if (!container) return;

    const config = JSON.parse(container.dataset.config || '{}');
    const { products = [], initialCategory = 'all', perPage = 12, lang = 'en', strings = {} } = config;

    let searchQuery = '';
    let categoryFilter = initialCategory;
    let currentPage = 1;

    function filterProducts() {
      return products.filter((p) => {
        const q = searchQuery.toLowerCase();
        const matchSearch =
          !q ||
          (p.name || '').toLowerCase().includes(q) ||
          (p.description || '').toLowerCase().includes(q);
        const matchCategory = categoryFilter === 'all' || p.category === categoryFilter;
        return matchSearch && matchCategory;
      });
    }

    function esc(s) {
      return String(s == null ? '' : s).replace(/[&<>"]/g, (c) =>
        ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
    }

    function specsHtml(specs) {
      const entries = Object.entries(specs || {});
      if (!entries.length) return '';
      return `<dl class="specs">${entries
        .map(([k, v]) => `<dt>${esc(k)}</dt><dd>${esc(v)}</dd>`)
        .join('')}</dl>`;
    }

    function cardHtml(p) {
      const href = `/${lang}/product/${p.id}`;
      const desc = (p.description || '');
      const shortDesc = desc.length > 95 ? desc.slice(0, 95) + '…' : desc;
      return `
        <article class="card">
          <a href="${href}" class="card-photo" aria-label="${esc(p.name)}">
            <img src="${esc(p.image)}" alt="${esc(p.name)}" width="400" height="400" loading="lazy" class="photo-img" />
            ${p.has3d ? '<span class="badge3d">3D</span>' : ''}
          </a>
          <div class="card-body">
            <div class="card-top"><span class="cat">${esc(p.categoryName)}</span></div>
            <a href="${href}" class="card-name">${esc(p.name)}</a>
            ${p.tag ? `<div class="card-tag">${esc(p.tag)}</div>` : ''}
            <p class="card-desc">${esc(shortDesc)}</p>
            ${specsHtml(p.specs)}
          </div>
          <div class="card-footer">
            <a href="${href}" class="btn btn-outline btn-sm">${esc(strings.details)}</a>
            <a href="/${lang}/contact" class="btn btn-primary btn-sm">${esc(strings.requestQuote)}</a>
          </div>
        </article>`;
    }

    function render() {
      const filtered = filterProducts();
      const results = document.getElementById('catalog-results');
      const empty = document.getElementById('catalog-empty');
      const paginationEl = document.getElementById('catalog-pagination');
      if (!results) return;

      const total = filtered.length;
      const totalPages = Math.max(1, Math.ceil(total / perPage));
      currentPage = Math.min(currentPage, totalPages);
      const start = (currentPage - 1) * perPage;
      const pageProducts = filtered.slice(start, start + perPage);

      if (total === 0) {
        results.innerHTML = '';
        empty?.removeAttribute('hidden');
        paginationEl.innerHTML = '';
        return;
      }
      empty?.setAttribute('hidden', '');
      results.innerHTML = pageProducts.map(cardHtml).join('');

      const startItem = start + 1;
      const endItem = Math.min(start + perPage, total);
      if (totalPages > 1) {
        paginationEl.innerHTML = `
          <p class="pag-info">${strings.showing} ${startItem}–${endItem} ${strings.of} ${total} ${strings.products}</p>
          <div class="pag-btns">
            <button type="button" data-prev class="btn btn-outline btn-sm">${strings.prev}</button>
            <span class="pag-page">${strings.page} ${currentPage} ${strings.pageOf} ${totalPages}</span>
            <button type="button" data-next class="btn btn-outline btn-sm">${strings.next}</button>
          </div>`;
        const prevBtn = paginationEl.querySelector('[data-prev]');
        const nextBtn = paginationEl.querySelector('[data-next]');
        prevBtn.disabled = currentPage <= 1;
        nextBtn.disabled = currentPage >= totalPages;
        prevBtn?.addEventListener('click', () => { if (currentPage > 1) { currentPage--; render(); } });
        nextBtn?.addEventListener('click', () => { if (currentPage < totalPages) { currentPage++; render(); } });
      } else {
        paginationEl.innerHTML = '';
      }
    }

    function updateCategoryButtons() {
      container.querySelectorAll('[data-category-id]').forEach((btn) => {
        btn.classList.toggle('active', categoryFilter === btn.dataset.categoryId);
      });
    }

    const searchInput = container.querySelector('#catalog-search');
    searchInput?.addEventListener('input', (e) => {
      searchQuery = (e.target?.value || '').trim();
      currentPage = 1;
      render();
    });

    container.querySelectorAll('[data-category-id]').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        categoryFilter = btn.dataset.categoryId || 'all';
        currentPage = 1;
        updateCategoryButtons();
        render();
      });
    });

    render();
  })();
</script>

<style>
  .cat-controls { display: flex; flex-direction: column; gap: 16px; margin-bottom: 28px; }
  .cat-grid {
    display: grid; gap: 16px;
    grid-template-columns: repeat(4, 1fr);
  }
  .cat-empty {
    text-align: center; padding: 64px 16px;
    border: 1px solid var(--border); border-radius: var(--r-lg);
    background: var(--bg-card); color: var(--t2);
  }
  .cat-pagination {
    margin-top: 28px;
    display: flex; align-items: center; justify-content: space-between;
    flex-wrap: wrap; gap: 12px;
  }
  .pag-info { font-size: 13px; color: var(--t3); }
  .pag-btns { display: flex; align-items: center; gap: 12px; }
  .pag-page { font-size: 13px; color: var(--t2); }
  .pag-btns .btn:disabled { opacity: 0.4; cursor: not-allowed; }

  @media (max-width: 1100px) { .cat-grid { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 820px)  { .cat-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 520px)  { .cat-grid { grid-template-columns: 1fr; } }
</style>
