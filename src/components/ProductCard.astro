---
import { useTranslations, localizePath, pick, type Lang } from '../i18n/ui';

interface Props {
  product: any;
  lang: Lang;
  categoryName: string;
}
const { product, lang, categoryName } = Astro.props;
const t = useTranslations(lang);

const name = pick(product.name, lang) as string;
const description = pick(product.description, lang) as string;
const specs = (pick(product.specs, lang) as Record<string, string>) ?? {};
const tag = pick(product.tag, lang) as string | undefined;
const galleryImages = (product.images?.length ? product.images : [product.image]) as string[];
const specEntries = Object.entries(specs);
const shortDesc = description.length > 95 ? description.slice(0, 95) + '…' : description;
const href = localizePath(`/product/${product.id}`, lang);
const has3d = Boolean(product.model3d);
---

<article class="card">

  <!-- Photo -->
  <a href={href} class="card-photo" aria-label={name}>
    <img
      src={galleryImages[0]}
      alt={name}
      width="400" height="400"
      loading="lazy" decoding="async"
      class="photo-img"
    />
    {has3d && <span class="badge3d">3D</span>}
  </a>

  <!-- Body -->
  <div class="card-body">
    <div class="card-top">
      <span class="cat">{categoryName}</span>
    </div>
    <a href={href} class="card-name">{name}</a>
    {tag && <div class="card-tag">{tag}</div>}
    <p class="card-desc">{shortDesc}</p>

    {specEntries.length > 0 && (
      <dl class="specs">
        {specEntries.map(([k, v]) => (
          <>
            <dt>{k}</dt>
            <dd>{v}</dd>
          </>
        ))}
      </dl>
    )}
  </div>

  <!-- Footer -->
  <div class="card-footer">
    <a href={href} class="btn btn-outline btn-sm">{t('common.details')}</a>
    <a href={localizePath('/contact', lang)} class="btn btn-primary btn-sm">{t('common.requestQuote')}</a>
  </div>
</article>
