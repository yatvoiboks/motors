---
import { useTranslations, localizePath, pick, type Lang } from '../i18n/ui';
import categories from '../data/categories.json';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();
const productCats = categories.filter((c) => c.id !== 'all');
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div>
      <div class="footer-logo">
        <img src="/images/logo-mark.png" alt="GlobalRobotex" class="footer-mark" width="28" height="28" />
        <span><span class="la">G</span>lobal<span class="la">R</span>obotex</span>
      </div>
      <p class="footer-desc">{t('footer.desc')}</p>
    </div>

    <div>
      <h4 class="footer-heading">{t('footer.products')}</h4>
      <ul class="footer-links">
        {productCats.map((c) => (
          <li><a href={localizePath(`/catalog/${c.slug}`, lang)}>{pick(c.name, lang)}</a></li>
        ))}
      </ul>
    </div>

    <div>
      <h4 class="footer-heading">{t('footer.company')}</h4>
      <ul class="footer-links">
        <li><a href={localizePath('/about', lang)}>{t('nav.about')}</a></li>
        <li><a href={localizePath('/contact', lang)}>{t('nav.contact')}</a></li>
        <li><a href={localizePath('/terms', lang)}>{t('footer.terms')}</a></li>
        <li><a href={localizePath('/privacy', lang)}>{t('footer.privacy')}</a></li>
      </ul>
    </div>

    <div>
      <h4 class="footer-heading">{t('footer.contact')}</h4>
      <ul class="footer-links">
        <li><a href="mailto:sales@globalrobotex.com">sales@globalrobotex.com</a></li>
        <li class="muted">{t('footer.hours')}</li>
        <li><a href={`/catalog.${lang}.pdf`} target="_blank" rel="noopener">{t('common.downloadCatalog')}</a></li>
      </ul>
    </div>
  </div>

  <div class="footer-bottom container">
    <span>© {year} GlobalRobotex. {t('footer.rights')}</span>
    <span class="muted">{t('footer.tagline')}</span>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border);
    background: var(--bg-2);
    padding: 48px 0 0;
  }
  .la { color: var(--accent); }
  .footer-logo {
    display: flex; align-items: center; gap: 8px;
    font-size: 15px; font-weight: 800; letter-spacing: -0.01em;
    color: var(--t1); margin-bottom: 12px;
  }
  .footer-mark { height: 28px; width: auto; display: block; }
  .footer-desc { font-size: 13px; color: var(--t3); max-width: 240px; line-height: 1.6; }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1fr;
    gap: 40px;
    padding-bottom: 40px;
  }

  .footer-heading {
    font-size: 11px; font-weight: 600;
    letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--t1); margin-bottom: 14px;
  }
  .footer-links { list-style: none; display: flex; flex-direction: column; gap: 8px; }
  .footer-links a {
    font-size: 13px; color: var(--t3); text-decoration: none;
    transition: color 0.15s;
  }
  .footer-links a:hover { color: var(--accent); }
  .muted { font-size: 13px; color: var(--t3); }

  .footer-bottom {
    display: flex; justify-content: space-between; align-items: center;
    flex-wrap: wrap; gap: 8px;
    padding-top: 20px; padding-bottom: 20px;
    border-top: 1px solid var(--border);
    font-size: 12px; color: var(--t3);
  }

  @media (max-width: 768px) {
    .footer-grid { grid-template-columns: 1fr 1fr; gap: 28px; }
  }
  @media (max-width: 480px) {
    .footer-grid { grid-template-columns: 1fr; }
  }
</style>
