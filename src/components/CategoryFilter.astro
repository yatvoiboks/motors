---
import { localizePath, pick, type Lang } from '../i18n/ui';

interface Props {
  categories: any[];
  activeCategory: string;
  lang: Lang;
  clientFilter?: boolean;
}

const { categories, activeCategory, lang, clientFilter = false } = Astro.props;
---

<div class="cat-filter" data-category-filter>
  {categories.map((cat) => {
    const isActive = activeCategory === cat.id;
    const label = pick(cat.name, lang);
    const href = cat.id === 'all'
      ? localizePath('/catalog', lang)
      : localizePath(`/catalog/${cat.slug}`, lang);
    if (clientFilter) {
      return (
        <button type="button" data-category-id={cat.id} class={`cat-pill ${isActive ? 'active' : ''}`}>
          {label}
        </button>
      );
    }
    return <a href={href} class={`cat-pill ${isActive ? 'active' : ''}`}>{label}</a>;
  })}
</div>

<style>
  .cat-filter { display: flex; flex-wrap: wrap; gap: 8px; }
  .cat-pill {
    padding: 8px 16px; border-radius: 999px;
    font-family: var(--font); font-size: 13px; font-weight: 600;
    color: var(--t2); background: var(--bg-card);
    border: 1px solid var(--border); cursor: pointer;
    text-decoration: none; line-height: 1;
    transition: border-color 0.15s, color 0.15s, background 0.15s;
  }
  .cat-pill:hover { border-color: var(--accent); color: var(--t1); }
  .cat-pill.active {
    background: var(--accent); border-color: var(--accent); color: #fff;
  }
</style>
